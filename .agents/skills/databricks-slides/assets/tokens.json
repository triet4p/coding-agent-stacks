  },
  "geometry": {
    "margin": 0.70,
    "content_width": 11.933,
    "header": { "eyebrow_y": 0.30, "title_y": 0.66, "subtitle_y_1line": 1.52, "subtitle_y_2line": 1.56 },
    "body": { "top": 2.02, "bottom": 6.72, "height": 4.70 },
    "decision": { "top": 6.02, "bottom": 6.58, "panel_height": 0.56 },
    "footer": { "rule_y": 6.98, "label_y": 7.08 },
    "radius": { "card": 0.10, "node": 0.05, "frame": 0.03 },
    "callout_cap": 1.60,
    "callout_cap_ui_rail": 1.25,
