    "min_learner_pt": 13,
    "max_template_share_pct": 25,
    "max_consecutive_same": 2,
    "max_consecutive_ui_tour": 3,
    "max_table_share_pct": 20,
    "max_decision_share_pct": 25,
    "max_card_bullets": 3,
    "max_architecture_notes": 2,
    "max_screenshot_annotations": 3
